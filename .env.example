# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=site-images

# Application URLs
# In local development use http://localhost:3000. In production use your Vercel URL (e.g. https://ostra-website.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time admin setup code (32 random characters generated for account creation)
ADMIN_SETUP_CODE=your-random-32-char-setup-code

# Optional admin subdomain (e.g. admin.mydomain.com). Leave empty to use /admin on the primary domain.
ADMIN_HOST=
